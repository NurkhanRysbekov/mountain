p_high = 0.909  # 1-тапсырмадан алынған ықтималдық
p_low = 1 - p_high
 
actions = {
    'Extra': ([p_high, p_low], [0, -60]),
    'Usual': ([p_high, p_low], [-30, 0])
}

def EU(probs, utilities): #Expected Utility функциясы әр ықтималдықты оған сәйкес пайдалылыққа көбейтіп, қосындысын шығарады
    return sum(p*u for p,u in zip(probs, utilities))
 
scores = {name: EU(*values) for name, values in actions.items()}
print("Падалылық мәндері:", scores)
print("Таңдалған әрекет:", max(scores, key=scores.get)) #ең жоғары пайдалылық әкелетін әрекет


